{
  "name": "cloud-quest-devops-dungeon",
  "version": "0.1.0",
  "description": "Cloud Quest: DevOps Dungeon - A roguelike web game for learning DevOps",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"lambda/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"lambda/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md}\" \"lambda/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\" \"lambda/**/*.ts\" \"*.{json,md}\""
  },
  "dependencies": {
    "phaser": "^3.80.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
