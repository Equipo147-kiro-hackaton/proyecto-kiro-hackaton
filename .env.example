# =============================================================================
# Cloud Quest: DevOps Dungeon — Variables de Entorno
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto (NO commitear .env)
# 2. Rellena cada variable con tus valores reales
# 3. Para el token de GitHub, configúralo también como variable de entorno
#    del sistema operativo (GITHUB_TOKEN) para que Kiro MCP pueda usarlo
# =============================================================================

# --- Frontend (Vite) ---
# URL base del API Gateway desplegado en AWS Amplify
# Ejemplo: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=

# --- GitHub MCP (configurar como variable de sistema, NO solo en .env) ---
# Token con permisos: repo, read:org
# Windows PowerShell: $env:GITHUB_TOKEN = "ghp_xxxx"
# macOS/Linux:        export GITHUB_TOKEN="ghp_xxxx"
# O agrégalo permanentemente en las variables de entorno del sistema
GITHUB_TOKEN=

# --- AWS (para desarrollo local con Lambda) ---
# Región donde está desplegada la infraestructura
AWS_REGION=us-east-1
# Nombre de la tabla DynamoDB
DYNAMODB_TABLE_NAME=cloud-quest-scores
